# Local env
.env
/sample-output/
# Root-level research output is deliberately not ignored: it is a misconfiguration. Runtime
# artifacts belong under apps/game-service/research/ or apps/research-service/research/.
/logs/
/logs-archive-*/
/simulation-history/**
!/simulation-history/**/
!/simulation-history/**/.gitkeep
# Runtime research evidence is machine-local and may contain prompts, model output,
# or operator data. These paths are intentionally never release artifacts.
/apps/game-service/research/
/apps/research-service/research/
/apps/game-service/logs/
/apps/research-service/logs/
/apps/game-service/simulation-history/
/apps/research-service/simulation-history/
scratch.txt

# Claude Code per-session state (lockfile + local permission overrides)
/.claude/

# Maven Shade
dependency-reduced-pom.xml

# Python bytecode caches (scripts/graffiti and any other ad-hoc Python tools)
__pycache__/
*.pyc
